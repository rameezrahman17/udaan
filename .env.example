# Project Udaan — Environment Configuration
# Copy this file to .env or .env.local for local development.
# IMPORTANT: Never commit actual service keys or production secrets to source control.

# Supabase Online Backend Configuration
# Obtain your project URL and public Anon key from your Supabase Dashboard:
# Project Settings -> API -> Project URL & Project API Keys (anon/public)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-placeholder

# Application Configuration
VITE_APP_TITLE="Project Udaan - Nabha Digital Learning"
VITE_DEFAULT_LANGUAGE=pa
VITE_ENABLE_OFFLINE_SYNC=true
